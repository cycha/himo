# Production Dockerfile for Vite React App
# Multi-stage build for optimal size

# Stage 1: Build the application
FROM node:25-alpine AS builder

WORKDIR /app

# Install pnpm (pinned to match lockfile)
RUN npm install -g pnpm@10.22.0

# Copy root config files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .pnpmfile.cjs tsconfig.json ./

# Copy workspace package.json files (monorepo structure)
COPY commons/package.json ./commons/
COPY api/package.json ./api/
COPY client/package.json ./client/

# Copy workspace source code (needed for proper monorepo resolution)
COPY commons ./commons
COPY client ./client

# Install dependencies for client workspace only (reduces memory usage)
RUN pnpm install --frozen-lockfile --filter client

# Build client from its directory
WORKDIR /app/client
RUN pnpm run build

# Stage 2: Serve with Nginx
FROM nginx:stable-alpine

# Copy built files from builder stage (Vite outputs to build directory)
COPY --from=builder /app/client/build /usr/share/nginx/html

# Copy nginx configuration
COPY client/nginx.conf /etc/nginx/conf.d/default.conf

# Expose ports 80 (HTTP) and 443 (HTTPS)
EXPOSE 80 443

# Health check (verify nginx process is running)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ps aux | grep -v grep | grep nginx || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]