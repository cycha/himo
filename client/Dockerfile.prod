# Production Dockerfile for Vite React App
# Multi-stage build for optimal size

# Stage 1: Build the application
FROM node:25-alpine AS builder

# Build argument for API URL
ARG VITE_API_URL=https://himoapp.duckdns.org/api

WORKDIR /app

# Install pnpm (pinned to match lockfile)
RUN npm cache clean --force && npm install -g pnpm@10.22.0

# Copy root config files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .pnpmfile.cjs tsconfig.json ./

# Copy workspace package.json files (monorepo structure)
COPY commons/package.json ./commons/
COPY api/package.json ./api/
COPY client/package.json ./client/

# Copy workspace source code (needed for proper monorepo resolution)
COPY commons ./commons
COPY client ./client

# Install dependencies for client workspace only (reduces memory usage)
RUN pnpm install --frozen-lockfile --filter client

# Build client from its directory with VITE_API_URL build arg
WORKDIR /app/client
RUN VITE_API_URL=${VITE_API_URL} pnpm run build

# Stage 2: Static bundle only. The edge Caddy on the VPS (/opt/edge) serves
# these files and proxies /api; this container just copies them into the
# shared host directory mounted at /out, then exits.
FROM busybox:1.37

COPY --from=builder /app/client/build /app/dist
COPY client/sync-static.sh /usr/local/bin/sync-static

CMD ["/bin/sh", "/usr/local/bin/sync-static"]
