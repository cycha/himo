# Production Dockerfile for Vite React App
# Multi-stage build for optimal size

# Stage 1: Build the application
FROM node:25-alpine as builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy root package files, lockfile, and workspace config
COPY package*.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy all workspace package.json files first (monorepo structure)
COPY commons/package*.json ./commons/
COPY api/package*.json ./api/
COPY client/package*.json ./client/

# Copy workspace source code (needed for proper monorepo resolution)
COPY commons ./commons
COPY client ./client

# Install all dependencies
RUN pnpm install

# Build client from its directory
WORKDIR /app/client
RUN pnpm run build

# Stage 2: Serve with Nginx
FROM nginx:stable-alpine

# Copy built files from builder stage (Vite outputs to dist by default)
COPY --from=builder /app/client/dist /usr/share/nginx/html

# Copy nginx configuration
COPY client/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]