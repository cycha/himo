# ===========================================
# Himo - Production Environment
# ===========================================
# Copy this file to .env.production and fill with production values
# This file will be copied to VPS during deployment
# DO NOT commit .env.production to version control

# -------------------------------------------
# Database Configuration (PostgreSQL)
# -------------------------------------------
# Database connection string (internal Docker network)
DATABASE_URL=postgresql://himo_user:CHANGE_THIS_PASSWORD@db:5432/himo

# Database credentials
# Generate secure password: openssl rand -base64 24
DB_USER=himo_user
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_NAME=himo

# -------------------------------------------
# API Configuration
# -------------------------------------------
NODE_ENV=production
PORT=3000

# JWT Configuration
# CRITICAL: Change this in production!
# Generate secure key: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_RANDOM_32_CHARS_MINIMUM
JWT_EXPIRES_IN=7d

# CORS Configuration
# Set to your production domain (where frontend is accessed)
CORS_ORIGIN=https://your-domain.com

# -------------------------------------------
# Client Configuration (React + Vite)
# -------------------------------------------
# Public API URL accessible from browser
# API is proxied through nginx at /api path (see client/nginx.conf)
# Examples:
#   With domain: https://your-domain.com/api
#   With IP:     http://YOUR_VPS_IP/api
VITE_API_URL=https://your-domain.com/api

# -------------------------------------------
# Bot Configuration (Web Scraper)
# -------------------------------------------
# Internal Docker network URL
BOT_API_BASE_URL=http://api:3000

# -------------------------------------------
# GitHub Container Registry (GHCR)
# -------------------------------------------
# Required for VPS to pull Docker images from GHCR
# Create token at: https://github.com/settings/tokens
# Required scope: write:packages
GITHUB_TOKEN=ghp_YOUR_GITHUB_TOKEN_HERE
