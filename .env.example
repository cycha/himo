# Database Configuration
DATABASE_URL=postgresql://himo_user:password123@db:5432/himo
DB_USER=himo_user
DB_PASSWORD=password123
DB_NAME=himo

# API Configuration
NODE_ENV=production
JWT_SECRET=your-super-secret-jwt-key-change-this

# Client Configuration
VITE_API_URL=http://api:3000

# Bot Configuration
BOT_API_BASE_URL=http://api:3000
SCRAPING_INTERVAL=0 */2 5-22 * * *
HEADLESS=true

# Free VPS Strategy: Scrape every 2 hours (instead of every 15 min)
# Expected: ~50 ads per run × 8 runs/day = ~400 ads/day for FREE
# For even more conservative: 0 8,20 * * * (twice per day: 8 AM & 8 PM)

# Proxy Configuration (HIGHLY RECOMMENDED for DataDome bypass)
