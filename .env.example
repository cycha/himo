# ===========================================
# Himo - Local Development Environment
# ===========================================
# Copy this file to .env for local development
# DO NOT commit .env to version control

# -------------------------------------------
# Database Configuration (PostgreSQL)
# -------------------------------------------
DATABASE_URL=postgresql://himo_user:himo_dev_password@localhost:5432/himo
DB_USER=himo_user
DB_PASSWORD=himo_dev_password
DB_NAME=himo

# -------------------------------------------
# API Configuration
# -------------------------------------------
NODE_ENV=development
PORT=3000

# JWT Configuration
# Generate secure key: openssl rand -base64 32
JWT_SECRET=dev-secret-change-in-production-32-chars-minimum
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3001

# -------------------------------------------
# Client Configuration (React + Vite)
# -------------------------------------------
VITE_API_URL=http://localhost:3000

# -------------------------------------------
# Bot Configuration (Web Scraper)
# -------------------------------------------
BOT_API_BASE_URL=http://localhost:3000

# Free VPS Strategy: Scrape every 2 hours (instead of every 15 min)
# Expected: ~50 ads per run × 8 runs/day = ~400 ads/day for FREE
# For even more conservative: 0 8,20 * * * (twice per day: 8 AM & 8 PM)
SCRAPING_INTERVAL=0 */2 5-22 * * *
HEADLESS=true

# Proxy Configuration (HIGHLY RECOMMENDED for DataDome bypass)
# Use residential proxies for best results
# PROXY_HOST=proxy.provider.com
# PROXY_PORT=8080
# PROXY_USERNAME=your_username
# PROXY_PASSWORD=your_password
