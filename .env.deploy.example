# ===========================================
# Himo - Deployment Credentials
# ===========================================
# Copy this file to .env.deploy and fill with your VPS credentials
# Used by scripts/deploy-manual.sh for manual deployment
# DO NOT commit .env.deploy to version control

# -------------------------------------------
# VPS Connection Details
# -------------------------------------------
# Your VPS IP address or hostname
export VPS_HOST="YOUR_VPS_IP_ADDRESS"

# SSH user (typically root or deploy)
export VPS_USER="root"

# Path to your SSH private key for VPS access
# Default: $HOME/.ssh/id_rsa
# If using IntelliJ SSH: check Settings > Tools > SSH Configurations
export VPS_SSH_PRIVATE_KEY="$HOME/.ssh/id_rsa"

# -------------------------------------------
# GitHub Container Registry (GHCR)
# -------------------------------------------
# Required for pushing Docker images to GHCR
# Create token at: https://github.com/settings/tokens
# Required scope: write:packages
export GITHUB_TOKEN="ghp_YOUR_GITHUB_TOKEN_HERE"