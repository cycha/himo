// Himo - Real Estate Aggregator
// PostgreSQL + PostGIS Schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis(schema: "public")]
}

// User Model
model User {
  id        String   @id @default(uuid())
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  
  @@map("users")
  @@index([email])
}

// Ad Model (Real Estate Listing)
model Ad {
  id               String            @id @default(uuid())
  title            String            @db.VarChar(200)
  description      String            @db.Text
  thumbUrls        String[]          @default([]) @map("thumb_urls")
  url              String            @unique @db.VarChar(500)
  
  // Property details
  realEstateType   RealEstateType?   @map("real_estate_type")
  rooms            Int?              @db.SmallInt
  surface          Int?              @db.SmallInt
  immoSellType     ImmoSellType?     @map("immo_sell_type")
  price            Int
  
  // Provider info
  provider         Provider
  releaseDate      DateTime          @map("release_date") @db.Timestamptz
  
  // Location
  regionName       String?           @map("region_name") @db.VarChar(100)
  departmentId     String?           @map("department_id") @db.VarChar(10)
  departmentName   String?           @map("department_name") @db.VarChar(100)
  city             String?           @db.VarChar(100)
  zipcode          String            @db.VarChar(10)
  
  // Geospatial (PostGIS)
  latitude         Float?
  longitude        Float?
  
  // Timestamps
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  
  @@map("ads")
  @@index([provider, releaseDate(sort: Desc)])
  @@index([price])
  @@index([surface])
  @@index([realEstateType])
  @@index([zipcode])
  @@index([latitude, longitude])
}

// Enums
enum RealEstateType {
  appartement
  maison
  terrain
  parking
  local_commercial
}

enum ImmoSellType {
  neuf
  ancien
}

enum Provider {
  leboncoin
  seloger
  pap
  bienici
}

// Bot Run Model (Scraper execution tracking)
model BotRun {
  id                       String       @id @default(uuid())
  status                   BotRunStatus @default(running)
  startTime                DateTime     @default(now()) @map("start_time") @db.Timestamptz
  endTime                  DateTime?    @map("end_time") @db.Timestamptz

  // Statistics
  adsSaved                 Int?         @map("ads_saved") @db.Integer
  pagesScraped             Int?         @map("pages_scraped") @db.Integer
  failurePercentage        Float?       @map("failure_percentage") @db.Real
  averageRetriesPerRequest Float?       @map("average_retries_per_request") @db.Real

  // Error tracking
  errorMessage             String?      @map("error_message") @db.Text

  // Metadata
  triggeredBy              String?      @map("triggered_by") @db.VarChar(50) // 'cron' or 'manual'

  @@map("bot_runs")
  @@index([startTime(sort: Desc)])
  @@index([status])
}

enum BotRunStatus {
  running
  completed
  failed
  stopped
}
