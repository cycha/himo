// Himo - Real Estate Aggregator
// PostgreSQL + PostGIS Schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  engineType      = "library"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis(schema: "public")]
}

// User Model
model User {
  id        String   @id @default(uuid())
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  
  @@map("users")
  @@index([email])
}

// Ad Model (Real Estate Listing)
model Ad {
  id               String            @id @default(uuid())
  title            String            @db.VarChar(200)
  description      String            @db.Text
  thumbUrls        String[]          @default([]) @map("thumb_urls")
  url              String            @unique @db.VarChar(500)
  
  // Property details
  realEstateType   RealEstateType?   @map("real_estate_type")
  rooms            Int?              @db.SmallInt
  surface          Int?              @db.SmallInt
  immoSellType     ImmoSellType?     @map("immo_sell_type")
  price            Int
  
  // Provider info
  provider         Provider
  releaseDate      DateTime          @map("release_date") @db.Timestamptz
  
  // Location
  regionName       String?           @map("region_name") @db.VarChar(100)
  departmentId     String?           @map("department_id") @db.VarChar(10)
  departmentName   String?           @map("department_name") @db.VarChar(100)
  city             String?           @db.VarChar(100)
  zipcode          String            @db.VarChar(10)
  
  // Geospatial (PostGIS)
  latitude         Float?
  longitude        Float?
  
  // Timestamps
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  
  @@map("ads")
  @@index([provider, releaseDate(sort: Desc)])
  @@index([price])
  @@index([surface])
  @@index([realEstateType])
  @@index([zipcode])
  @@index([latitude, longitude])
}

// Enums
enum RealEstateType {
  appartement
  maison
  terrain
  parking
  local_commercial @map("local-commercial")
}

enum ImmoSellType {
  neuf
  ancien
}

enum Provider {
  leboncoin
  seloger
  pap
  bienici
}
