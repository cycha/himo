FROM node:18-alpine

WORKDIR /app

# Copy package files for all workspaces
COPY package*.json ./
COPY api/package*.json ./api/
COPY commons/package*.json ./commons/

# Install dependencies
RUN npm install

# Copy source code
COPY api/ ./api/
COPY commons/ ./commons/
COPY tsconfig.json ./

# Build TypeScript
RUN npm run build

WORKDIR /app/api

EXPOSE 3000 9229

CMD ["npm", "run", "dev"]
