# Server Configuration
API_PORT=3000
NODE_ENV=development

# Database - PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/himo?schema=public"

# JWT Secret (Generate a secure one: openssl rand -base64 32)
JWT_SECRET=himo-development-secret-key-change-me-in-production-32-chars
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3001
