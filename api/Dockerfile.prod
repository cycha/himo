# Prod build environment for react + node express app

FROM node:alpine

# Install pnpm
RUN npm install -g pnpm

# Copy common folder
WORKDIR /commons
COPY commons/package*.json commons/pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile
COPY commons .

# Create App Directory
WORKDIR /api

# Install Dependencies
COPY api/package*.json api/pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile

# Copy app source code
COPY api .

# Start node js server
CMD ["pnpm","start"]