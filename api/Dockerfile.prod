# Prod build environment for react + node express app

FROM node:alpine

# Install pnpm
RUN npm install -g pnpm

# Copy root package files and lockfile
COPY package*.json pnpm-lock.yaml ./

# Copy all workspace package.json files first (monorepo structure)
COPY commons/package*.json ./commons/
COPY client/package*.json ./client/
COPY api/package*.json ./api/

# Copy workspace source code (needed for proper monorepo resolution)
COPY commons ./commons
COPY api ./api

# Install all dependencies
RUN pnpm install

# Start node js server from api directory
WORKDIR /app/api
CMD ["pnpm", "start"]