# Prod build environment for Express API with TypeScript

FROM node:25-alpine

# Install build tools for native modules (bcrypt, etc)
RUN apk add --no-cache python3 make g++

# Install pnpm (pinned to match lockfile)
RUN npm install -g pnpm@10.22.0

# Set working directory
WORKDIR /app

# Copy root config files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .pnpmfile.cjs tsconfig.json ./

# Copy workspace package.json files (API + commons)
COPY commons/package.json ./commons/
COPY api/package.json ./api/

# Copy workspace source code for proper monorepo resolution
COPY commons ./commons
COPY api ./api

# Install dependencies for api workspace (includes commons)
RUN pnpm install --frozen-lockfile --filter api...

# Rebuild bcrypt for Linux environment
RUN cd /app/node_modules/.pnpm/bcrypt@*/node_modules/bcrypt && npm rebuild

# Generate Prisma Client
RUN pnpm --filter api exec prisma generate

# Build API TypeScript
RUN pnpm --filter api build

# Create startup script that resolves failed migrations, runs new ones, then starts the server
RUN echo '#!/bin/sh' > /app/docker-entrypoint.sh && \
    echo 'cd /app/api' >> /app/docker-entrypoint.sh && \
    echo 'echo "Checking for failed migrations..."' >> /app/docker-entrypoint.sh && \
    echo 'npx prisma migrate resolve --rolled-back 20251101124956_init 2>&1 || true' >> /app/docker-entrypoint.sh && \
    echo 'echo "Running database migrations..."' >> /app/docker-entrypoint.sh && \
    echo 'npx prisma migrate deploy 2>&1 || true' >> /app/docker-entrypoint.sh && \
    echo 'cd /app' >> /app/docker-entrypoint.sh && \
    echo 'echo "Migrations complete, starting API server..."' >> /app/docker-entrypoint.sh && \
    echo 'node api/dist/server.js' >> /app/docker-entrypoint.sh && \
    chmod +x /app/docker-entrypoint.sh

# Start API server with migrations
CMD ["/app/docker-entrypoint.sh"]