{
  "name": "@himo/bot",
  "version": "2.0.0",
  "description": "Web scraper bot for French real estate websites",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "lbc": "tsx src/scrapers/leboncoin.ts",
    "test": "jest",
    "test:scraper": "tsx tests/scraper.test.ts",
    "test:debug": "tsx tests/debug.test.ts",
    "test:mock": "tsx tests/scraper-mock.test.ts",
    "prisma:generate": "prisma generate --schema=../api/prisma/schema.prisma"
  },
  "author": "Charly Joulie",
  "license": "MIT",
  "dependencies": {
    "@himo/commons": "file:../commons",
    "@prisma/client": "^6.18.0",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "https-proxy-agent": "^7.0.2",
    "node-cron": "^4.2.1",
    "playwright": "^1.40.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.18.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2"
  }
}
