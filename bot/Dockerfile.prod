# Dockerfile for bot production with Xvfb support

FROM node:25-bullseye

# Install Xvfb and Chromium dependencies for Playwright
RUN apt-get update && apt-get install -y \
    xvfb \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libatspi2.0-0 \
    libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm (pinned to match lockfile)
RUN npm install -g pnpm@10.22.0

# Copy root config files
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .pnpmfile.cjs tsconfig.json ./

# Copy workspace package.json files (bot + commons + api for Prisma)
COPY commons/package.json ./commons/
COPY api/package.json ./api/
COPY bot/package.json ./bot/

# Copy workspace source code (needed for proper monorepo resolution)
COPY commons ./commons
COPY api ./api
COPY api/prisma ./api/prisma
COPY bot ./bot

# Install dependencies for both api and bot workspaces
RUN pnpm install --frozen-lockfile --filter api --filter bot

# Generate Prisma Client from API schema
RUN pnpm --filter api exec prisma generate

# Install Playwright browsers from bot workspace
WORKDIR /app/bot
RUN pnpm exec playwright install chromium --with-deps || echo "Playwright installation attempted"

# Build TypeScript
RUN pnpm run build || true

# Set display for Xvfb
ENV DISPLAY=:99
ENV HEADLESS=false

# Create startup script to resolve failed migrations before running bot
RUN echo '#!/bin/sh' > /app/bot-entrypoint.sh && \
    echo 'rm -f /tmp/.X99-lock && rm -f /tmp/.X11-unix/X99' >> /app/bot-entrypoint.sh && \
    echo 'Xvfb :99 -screen 0 1920x1080x24 -nolisten tcp &' >> /app/bot-entrypoint.sh && \
    echo 'sleep 3' >> /app/bot-entrypoint.sh && \
    echo 'cd /app/api' >> /app/bot-entrypoint.sh && \
    echo 'echo "Checking for failed migrations..."' >> /app/bot-entrypoint.sh && \
    echo 'npx prisma migrate resolve --rolled-back 20251101124956_init 2>/dev/null || true' >> /app/bot-entrypoint.sh && \
    echo 'echo "Running database migrations..."' >> /app/bot-entrypoint.sh && \
    echo 'npx prisma migrate deploy 2>/dev/null || true' >> /app/bot-entrypoint.sh && \
    echo 'cd /app/bot' >> /app/bot-entrypoint.sh && \
    echo 'pnpm start || { pkill -f Xvfb; exit 1; }' >> /app/bot-entrypoint.sh && \
    chmod +x /app/bot-entrypoint.sh

# Run with Xvfb, migrations, then bot
CMD ["/app/bot-entrypoint.sh"]