# Dockerfile for bot production with Xvfb support

FROM node:25-bullseye

# Install Xvfb and Chromium dependencies for Playwright
RUN apt-get update && apt-get install -y \
    xvfb \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libatspi2.0-0 \
    libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm
RUN npm install -g pnpm

# Copy root package files, lockfile, and workspace config
WORKDIR /app
COPY package*.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy only necessary workspace package.json files (bot + commons + api for Prisma)
COPY commons/package*.json ./commons/
COPY api/package*.json ./api/
COPY bot/package*.json ./bot/

# Copy workspace source code (needed for proper monorepo resolution)
COPY commons ./commons
COPY api ./api
COPY api/prisma ./api/prisma
COPY bot ./bot

# Install dependencies for bot workspace only (reduces memory usage)
RUN pnpm install --frozen-lockfile --filter bot

# Generate Prisma Client
WORKDIR /app/bot
RUN pnpm run prisma:generate

# Install Playwright browsers
RUN npx playwright install chromium --with-deps

# Build TypeScript
RUN pnpm run build

# Set display for Xvfb
ENV DISPLAY=:99
ENV HEADLESS=false

# Run with Xvfb (starts virtual display then run)
CMD ["sh", "-c", "Xvfb :99 -screen 0 1920x1080x24 -nolisten tcp & sleep 3 && pnpm start"]