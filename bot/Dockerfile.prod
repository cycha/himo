# Dockerfile for bot production with Xvfb support

FROM node:25-bullseye

# Install Xvfb and Chromium dependencies for Playwright
RUN apt-get update && apt-get install -y \
    xvfb \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libatspi2.0-0 \
    libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm (pinned to match lockfile)
RUN npm install -g pnpm@10.22.0

# Copy root config files
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .pnpmfile.cjs tsconfig.json ./

# Copy workspace package.json files (bot + commons + api for Prisma)
COPY commons/package.json ./commons/
COPY api/package.json ./api/
COPY bot/package.json ./bot/

# Copy workspace source code (needed for proper monorepo resolution)
COPY commons ./commons
COPY api ./api
COPY api/prisma ./api/prisma
COPY bot ./bot

# Install dependencies for bot workspace (postinstall hook will generate Prisma Client)
RUN pnpm install --frozen-lockfile --filter bot
RUN pnpm --filter bot exec prisma generate --schema=../api/prisma/schema.prisma 2>/dev/null || true

# Install Playwright browsers
RUN npx playwright install chromium --with-deps

# Build TypeScript
RUN pnpm run build || true

# Set display for Xvfb
ENV DISPLAY=:99
ENV HEADLESS=false

# Run with Xvfb (cleanup any stale locks, start virtual display, then run app)
CMD ["sh", "-c", "rm -f /tmp/.X99-lock && rm -f /tmp/.X11-unix/X99 && Xvfb :99 -screen 0 1920x1080x24 -nolisten tcp & sleep 3 && pnpm start || { pkill -f Xvfb; exit 1; }"]