{
  "name": "himo-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Real estate ad aggregator for the French market",
  "workspaces": [
    "api",
    "bot",
    "client",
    "commons"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "clean": "tsc --build --clean",
    "dev:api": "npm run dev --workspace=api",
    "dev:bot": "npm run dev --workspace=bot",
    "dev:client": "npm run dev --workspace=client",
    "start:api": "npm start --workspace=api",
    "start:bot": "npm start --workspace=bot",
    "start:client": "npm start --workspace=client",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
