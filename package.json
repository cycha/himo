{
  "name": "himo-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Real estate ad aggregator for the French market",
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter client dev",
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "clean": "tsc --build --clean && rm -rf api/dist bot/dist client/dist commons/dist",
    "dev:api": "pnpm --filter api dev",
    "dev:bot": "pnpm --filter bot dev",
    "dev:client": "pnpm --filter client dev",
    "start:api": "pnpm --filter api start",
    "start:bot": "pnpm --filter bot start",
    "start:client": "pnpm --filter client start",
    "seed": "pnpm --filter api seed",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --build",
    "test": "pnpm --filter api test"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.1",
    "js-yaml": "^4.1.1",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2"
  },
  "pnpm": {
    "overrides": {
      "hono": ">=4.10.3"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.22.0"
}
